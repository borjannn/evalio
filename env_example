POSTGRES_DB=evalio
POSTGRES_USER=evalio_user
POSTGRES_PASSWORD=evalio_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- AI-drafted feedback (optional) -------------------------------------------
# Everything below is off by default. The app runs, tests pass and quizzes work
# exactly as before without any of it — teacher-written feedback is unaffected.
# See docs/SETUP.md §11.

# From https://aistudio.google.com/apikey. Server-side only: never prefix any of
# these with NEXT_PUBLIC_, and never read them from the browser.
#
# ⚠️ Check this model still exists before trusting it. Google retires models to new
# keys while still listing them, and the failure is a 404 saying "no longer
# available to new users" on your first real call. `python manage.py shell` and
# `genai.Client(...).models.list()` shows what your key can actually use.
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Which provider drafts feedback. A dotted path to any class with a
# generate(prompt, schema, timeout) method — Django's import_string resolves it at
# call time, so swapping models is this one line plus that provider's key below.
# Defaults to Gemini when unset.
#   feedback.providers.gemini.GeminiProvider     (default)
#   feedback.providers.deepseek.DeepSeekProvider
#   feedback.providers.qwen.QwenProvider
AI_FEEDBACK_PROVIDER=feedback.providers.qwen.QwenProvider

# Qwen, on FINKI's self-hosted vLLM proxy — the current default above. Only
# QWEN_API_KEY is required; base URL and model already point at that proxy and its
# served alias. Read only when the provider above points at Qwen.
QWEN_API_KEY=
# QWEN_MODEL=qwen3.8-27b
# QWEN_BASE_URL=https://vllm.finki.ukim.mk

# DeepSeek — or any other OpenAI-compatible endpoint, including the same vLLM proxy
# as Qwen above (set DEEPSEEK_BASE_URL to its /v1 URL and DEEPSEEK_MODEL to the
# alias it serves). Only DEEPSEEK_API_KEY is required for DeepSeek's own API; base
# URL and model then default to https://api.deepseek.com and deepseek-chat. Read
# only when the provider above points at DeepSeek.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Leave false unless you have a key. With it off, the drafting endpoints answer
# 503 and nothing else in the app changes.
AI_FEEDBACK_ENABLED=false

# Seconds.
AI_FEEDBACK_TIMEOUT=30

# Questions drafted at once, and the ceiling the pacer holds the run under.
# Requests-per-minute is the constraint that bites first: check your key's actual
# limits in AI Studio rather than trusting these numbers. The free tier is small
# enough that one bulk run on a medium quiz can exhaust a day's quota.
AI_FEEDBACK_CONCURRENCY=2
AI_FEEDBACK_RPM=5

# Leave blank. Blank sends no thinking config at all and lets the model use its
# own, which is the only setting that survives a model change: 2.5 takes a budget
# in tokens where 0 disables thinking, Gemini 3 takes a `thinking_level` instead
# and rejects a budget outright. Set it to 0 only if you have pinned a 2.5 model
# and want the latency back.
AI_FEEDBACK_THINKING_BUDGET=
